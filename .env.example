# ── web (apps/web/.env.local) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
# Optional. Shared with the API's INTERNAL_PROXY_SECRET below so the API can trust a
# BFF-forwarded client IP for rate limiting login/register/answers. Leave unset to disable —
# the API just falls back to the raw connection IP. Generate the same way as JWT_SECRET.
INTERNAL_PROXY_SECRET=

# ── api (apps/api/.env) ─────────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Groq's hosted model catalog changes over time — if feedback/resume-parsing calls start 404ing
# at Groq, check GET https://api.groq.com/openai/v1/models with your key before assuming a code
# bug; see app/core/config.py's groq_llm_model docstring.
GROQ_LLM_MODEL=openai/gpt-oss-120b
# mysql+aiomysql://user:password@host:3306/rehearse — local Docker MySQL for dev,
# Aiven's free-tier MySQL 8 connection string for staging/prod (see README).
DATABASE_URL=
# TLS to MySQL: unset = on in production, off elsewhere. Production refuses to start with it
# explicitly false. DATABASE_SSL_CA is a path to the host's CA bundle (needed for Aiven). Leave
# both commented out unless you need them — an empty value is not a valid boolean.
# DATABASE_TLS=true
# DATABASE_SSL_CA=/path/to/ca.pem
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=rehearse-api
JWT_AUDIENCE=rehearse-web
ALLOWED_ORIGINS=http://localhost:3000
DAILY_ANSWER_LIMIT=30
# Feature flags (true/false). Panel interviews default on; the optional camera coach defaults off.
ENABLE_PANEL_INTERVIEW=true
ENABLE_CAMERA_COACH=false
# Optional, must match the web INTERNAL_PROXY_SECRET above exactly. Leave both unset in dev —
# rate limiting simply keys on the raw connection IP instead. REQUIRED (and enforced at startup)
# when ENVIRONMENT=production — see below.
INTERNAL_PROXY_SECRET=
# development | staging | production. Gates production-only startup checks (INTERNAL_PROXY_SECRET
# becomes required, /docs+/redoc+/openapi.json turn off unless ENABLE_API_DOCS=true) — see
# app/core/config.py's Settings.environment/docs_enabled. Defaults to "development" so a fresh
# checkout boots without extra config; every real deployment must set this explicitly.
ENVIRONMENT=development
# Serve /docs, /redoc and /openapi.json in production. Always on outside production regardless
# of this flag. Leave unset/false in production unless you have a specific reason to expose the
# API schema publicly.
ENABLE_API_DOCS=false
