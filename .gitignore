node_modules/
.pnpm-store/

# Next.js
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
apps/web/.vercel/

# Env — broad on purpose: any .env* file (including ones we haven't invented a name for yet,
# like a local .env.run scratch file) is ignored except the checked-in .env.example template.
.env*
!.env.example

