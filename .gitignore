apps/api/.venv/
apps/api/__pycache__/
apps/api/**/__pycache__/
apps/api/.pytest_cache/
apps/api/.ruff_cache/
apps/api/.mypy_cache/
apps/api/.pyright_cache/
apps/api/requirements.txt
apps/api/.vercel/
apps/api/*.db
*.pyc

# Build outputs
dist/
build/

# Testing
coverage/
apps/web/playwright-report/
apps/web/test-results/

