{
  "name": "rehearse",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/web --filter ./apps/api dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:api": "pnpm --filter ./apps/api dev",
    "lint": "pnpm --filter ./apps/web lint && pnpm --filter ./apps/api lint",
    "typecheck": "pnpm --filter ./apps/web typecheck && pnpm --filter ./apps/api typecheck",
    "test": "pnpm --filter ./apps/web test && pnpm --filter ./apps/api test",
    "build": "pnpm --filter ./apps/web build && pnpm --filter ./apps/api build",
    "format": "pnpm --filter ./apps/web format"
  }
}
